<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SchitayKa.Api</RootNamespace>
    <!-- Копировать собранный фронтенд (backend/wwwroot) в выходную папку bin/... -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <PropertyGroup>
    <FrontendDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\frontend'))</FrontendDir>
  </PropertyGroup>

  <ItemGroup Condition="!Exists('$(FrontendDir)')">
    <!-- Режим публикации без исходников фронтенда (сервер): берём готовый wwwroot как есть -->
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" LinkBase="wwwroot\" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(FrontendDir)')">
    <!-- Режим разработки: wwwroot — выход сборки vite, исключаем его из implicit Content,
         копируем в bin после сборки через _CopyWebRootAfterBuild -->
    <Content Remove="wwwroot\**" />
  </ItemGroup>

  <Target Name="_CopyWebRootAfterBuild" AfterTargets="Build">
    <ItemGroup>
      <_WpSrc Include="$(MSBuildProjectDirectory)\wwwroot\**" />
    </ItemGroup>
    <!-- SkipUnchangedFiles="false": vite при пересборке может выдать то же имя файла (index-<hash>.js)
         с новым содержимым и тем же mtime — MSBuild со "true" пропускал такое копирование,
         и из bin/... сервилась СТАРАЯ копия бандла (страницы «Счета»/«Семья» не появлялись). -->
    <Copy SourceFiles="@(_WpSrc)" DestinationFolder="$([System.IO.Path]::Combine($(OutDir), 'wwwroot', '%(RecursiveDir)'))" SkipUnchangedFiles="false" Condition="'@(_WpSrc)'!=''" />
  </Target>

  <!-- Страховка: удаляем устаревшие JS/CSS-бандлы в выходной папке, чтобы браузер не подхватывал
       старые файлы по кэшу и сервер не отдавал два бандла сразу. -->
  <Target Name="_CleanStaleWebRootAssets" BeforeTargets="_CopyWebRootAfterBuild">
    <ItemGroup>
      <_WpStale Include="$([System.IO.Path]::Combine($(OutDir), 'wwwroot', 'assets', '*.js'));$([System.IO.Path]::Combine($(OutDir), 'wwwroot', 'assets', '*.css'))"
                Exclude="$(MSBuildProjectDirectory)\wwwroot\assets\*" />
    </ItemGroup>
    <Delete Files="@(_WpStale)" Condition="'@(_WpStale)'!=''" />
    <Message Importance="high" Text="[SchitayKa] Удалены устаревшие бандлы в $(OutDir)wwwroot/assets: @(_WpStale->'%(Filename)%(Extension)', ', ')" Condition="'@(_WpStale)'!=''" />
  </Target>

  <!-- При публикации (dotnet publish / VS "Опубликовать") копируем собранный бандл напрямую в PublishDir -->
  <Target Name="_CopyWebRootToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PubWpSrc Include="$(MSBuildProjectDirectory)\wwwroot\**" />
    </ItemGroup>
    <Copy SourceFiles="@(_PubWpSrc)" DestinationFolder="$([System.IO.Path]::GetFullPath('$(PublishDir)wwwroot\%(RecursiveDir)'))" SkipUnchangedFiles="false" Condition="'@(_PubWpSrc)'!='' And '$(PublishDir)'!=''" />
    <Message Importance="high" Text="[SchitayKa] wwwroot скопирован в публикацию: $(PublishDir)wwwroot" Condition="'@(_PubWpSrc)'!=''" />
  </Target>

  <!-- Автосборка фронтенда при сборке проекта, если установлен Node.js и есть node_modules.
       Если npm отсутствует — предупреждение, но сборка .NET продолжается. -->

  <Target Name="BuildFrontend" BeforeTargets="BeforeBuild"
          Condition="Exists('$(FrontendDir)\package.json') And Exists('$(FrontendDir)\node_modules')">
    <Message Importance="high" Text="Building frontend (npm run build)..." />
    <Exec Command="npm run build" WorkingDirectory="$(FrontendDir)" IgnoreExitCode="true" ContinueOnError="WarnAndContinue">
      <Output TaskParameter="ExitCode" PropertyName="NpmExitCode" />
    </Exec>
    <Message Importance="high" Condition="'$(NpmExitCode)'!='0'" Text="WARNING: npm run build failed (exit $(NpmExitCode)). If this is new after 'git pull', run setup.cmd once to install dependencies." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.33" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

</Project>
