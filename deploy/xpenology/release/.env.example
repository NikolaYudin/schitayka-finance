# СчитайКа — переменные окружения проекта Container Manager.
#
# В архиве уже лежит готовый .env (с сгенерированным JWT_KEY).
# Этот файл — шаблон: нужен, если .env потерян или вы собираете архив без секретов.
#
# Создать .env автоматически (сгенерирует ключ):
#   sh scripts/init-env.sh
#
# .env содержит секрет — не публикуйте его и не выкладывайте в git.

# Порт, на котором приложение будет доступно на NAS.
APP_PORT=5023

# ОБЯЗАТЕЛЬНО: длинный случайный ключ подписи JWT (не короче 32 символов).
# Сгенерировать на NAS: openssl rand -base64 48
# При смене ключа все выданные токены станут недействительны (нужно войти заново).
JWT_KEY=

# Часовой пояс контейнера.
TZ=Europe/Moscow

# true  — создать demo@schitayka.ru / demo123 при первом запуске (для теста).
# false — production-режим: демо-аккаунта нет, регистрируйтесь через UI.
SEED_DEMO=false

# Репозиторий, по которому приложение проверяет обновления.
UPDATE_REPO_URL=https://github.com/NikolaYudin/schitayka-finance

# Необязательно: GitHub token (fine-grained, read-only) — повышает лимит API
# с 60 до 5000 запросов/час. Для обычной проверки раз в 10 минут не нужен.
GITHUB_TOKEN=

# Автоматическое обновление по кнопке «Обновить сейчас» в настройках.
# true  — приложение скачивает новую сборку из GitHub Releases и перезапускается;
# false — обновление только скриптом (scripts/update.sh).
# Обновлять может только администратор экземпляра (первый зарегистрированный пользователь).
SELF_UPDATE_ENABLED=true

# Коммит, из которого собран архив (подставляет упаковщик; для UI-сборки — unknown).
GIT_COMMIT=unknown
